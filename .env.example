# Porta da API (o Vite repassa /api para ela)
PORT=3001

# MariaDB/MySQL do XAMPP (usuário root sem senha é o padrão do XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ss_stay_safe

# Segredo usado para assinar o token de login. Troque por um texto longo e aleatório:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h
